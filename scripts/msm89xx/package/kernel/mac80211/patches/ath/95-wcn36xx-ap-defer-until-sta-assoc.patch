+#define WCN36XX_AP_DEFER_TIMEOUT (30 * HZ)
+
+static bool wcn36xx_sta_unassociated(struct wcn36xx *wcn)
+{
+	struct wcn36xx_vif *tmp;
+
+	list_for_each_entry(tmp, &wcn->vif_list, list) {
+		if (NL80211_IFTYPE_STATION == wcn36xx_priv_to_vif(tmp)->type &&
+		    !tmp->sta_assoc)
+			return true;
+	}
+
+	return false;
+}
+
+static void wcn36xx_ap_beacon_on(struct wcn36xx *wcn,
+				 struct ieee80211_vif *vif,
+				 struct ieee80211_bss_conf *bss_conf)
+{
+	struct sk_buff *skb;
+	u16 tim_off, tim_len;
+	enum wcn36xx_hal_link_state link_state;
+	struct wcn36xx_vif *vif_priv = wcn36xx_vif_to_priv(vif);
+
+	vif_priv->dtim_period = bss_conf->dtim_period;
+	vif_priv->bss_index = WCN36XX_HAL_BSS_INVALID_IDX;
+	wcn36xx_smd_config_bss(wcn, vif, NULL, vif->addr, false);
+	skb = ieee80211_beacon_get_tim(wcn->hw, vif, &tim_off, &tim_len, 0);
+	if (!skb) {
+		wcn36xx_err("failed to alloc beacon skb\n");
+		return;
+	}
+	wcn36xx_smd_send_beacon(wcn, vif, skb, tim_off, 0);
+	dev_kfree_skb(skb);
+
+	if (vif->type == NL80211_IFTYPE_ADHOC ||
+	    vif->type == NL80211_IFTYPE_MESH_POINT)
+		link_state = WCN36XX_HAL_LINK_IBSS_STATE;
+	else
+		link_state = WCN36XX_HAL_LINK_AP_STATE;
+
+	wcn36xx_smd_set_link_st(wcn, vif->addr, vif->addr, link_state);
+}
+
+static void wcn36xx_start_deferred_ap(struct wcn36xx *wcn)
+{
+	struct wcn36xx_vif *tmp;
+
+	list_for_each_entry(tmp, &wcn->vif_list, list) {
+		struct ieee80211_vif *vif = wcn36xx_priv_to_vif(tmp);
+
+		if (!tmp->ap_deferred)
+			continue;
+
+		tmp->ap_deferred = false;
+		wcn36xx_info("starting deferred AP vif %p\n", vif);
+		wcn36xx_ap_beacon_on(wcn, vif, &vif->bss_conf);
+	}
+}
+
+static void wcn36xx_ap_defer_timeout(struct work_struct *work)
+{
+	struct wcn36xx *wcn =
+		container_of(to_delayed_work(work), struct wcn36xx,
+			     ap_defer_work);
+	struct wcn36xx_vif *tmp;
+	bool deferred = false;
+
+	mutex_lock(&wcn->conf_mutex);
+
+	list_for_each_entry(tmp, &wcn->vif_list, list)
+		if (tmp->ap_deferred)
+			deferred = true;
+
+	if (!deferred) {
+		mutex_unlock(&wcn->conf_mutex);
+		return;
+	}
+
+	wcn36xx_info("STA did not associate, starting AP standalone\n");
+
+	list_for_each_entry(tmp, &wcn->vif_list, list) {
+		struct ieee80211_vif *vif = wcn36xx_priv_to_vif(tmp);
+
+		if (NL80211_IFTYPE_STATION != vif->type)
+			continue;
+
+		wcn36xx_smd_delete_bss(wcn, vif);
+		wcn36xx_smd_set_link_st(wcn, vif->addr, vif->addr,
+					WCN36XX_HAL_LINK_IDLE_STATE);
+	}
+
+	wcn36xx_start_deferred_ap(wcn);
+
+	mutex_unlock(&wcn->conf_mutex);
+}
