#!/bin/sh /etc/rc.common
START=99

SECTION="modem"

start() {
    M=""
    i=0
    while [ -z "$M" ] && [ $i -lt 30 ]; do
        M=$(mmcli -L 2>/dev/null | grep -o 'Modem/[0-9]*' | cut -d/ -f2 | head -1)
        [ -z "$M" ] && sleep 2
        i=$((i+1))
    done
    [ -z "$M" ] && { logger -t auto-apn "no modem"; exit 0; }

    STATE=$(mmcli -m $M 2>/dev/null | grep -o 'state: *[a-z-]*' | head -1 | awk '{print $2}')
    [ "$STATE" = "disabled" ] && mmcli -m $M --enable
    sleep 5

    SIM_PATH=$(mmcli -m $M 2>/dev/null | sed -n 's/.*primary sim path: *\(.*\)/\1/p' | head -1)
    [ -z "$SIM_PATH" ] && { logger -t auto-apn "no sim, skip"; exit 0; }

    SIM_ID=$(echo "$SIM_PATH" | grep -o '[0-9]*$')
    [ -z "$SIM_ID" ] && { logger -t auto-apn "no sim id, skip"; exit 0; }

    IMSI=""
    i=0
    while [ -z "$IMSI" ] && [ $i -lt 20 ]; do
        IMSI=$(mmcli -i $SIM_ID 2>/dev/null | sed -n 's/.*imsi: *\([0-9]*\).*/\1/p' | head -1)
        [ -z "$IMSI" ] && sleep 3
        i=$((i+1))
    done
    [ -z "$IMSI" ] && { logger -t auto-apn "no imsi, skip"; exit 0; }

    CODE=$(echo "$IMSI" | cut -c1-5)
    logger -t auto-apn "IMSI=$IMSI CODE=$CODE"

    case $CODE in
        46000|46002|46004|46007|46008) APN=cmnet; AUTH="none"; USER=""; PASS="" ;;
        46001|46006|46009) APN=3gnet; AUTH="none"; USER=""; PASS="" ;;
        46003|46011|46012) APN=ctnet; AUTH="both"; USER="ctnet@mycdma.cn"; PASS="vnet.mobi" ;;
        46015|46022|46123) APN=cbnet; AUTH="none"; USER=""; PASS="" ;;
        *)
            APN=$(mmcli -m $M 2>/dev/null | sed -n 's/.*initial bearer apn: *\(.*\)/\1/p' | head -1)
            [ -z "$APN" ] && APN=cmnet
            AUTH="none"; USER=""; PASS=""
            ;;
    esac

    logger -t auto-apn "APN=$APN"

    uci set network.$SECTION.apn="$APN"
    uci set network.$SECTION.username="$USER"
    uci set network.$SECTION.password="$PASS"
    uci set network.$SECTION.auth="$AUTH"
    uci commit network

    ifdown "$SECTION" 2>/dev/null
    sleep 2
    ifup "$SECTION"
}

stop() { :; }
