#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1

start_service() {
    procd_open_instance
    procd_set_param command /bin/sh -c '
        while true; do
            if ! ifstatus modem | grep -q "\"up\": true"; then
                STATE=$(mmcli -m any 2>/dev/null | sed -n "s/.*state: *\([a-z-]*\).*/\1/p" | head -1)
                [ "$STATE" = "disabled" ] && mmcli -m any --enable
                SIM_PATH=$(mmcli -m any --output-keyvalue 2>/dev/null | sed -n "s/^modem.generic.sim *: *//p")
                [ -n "$SIM_PATH" ] && {
                    logger -t "modem-watchdog" "Interface modem is down, restarting..."
                    ifup modem
                }
            fi
            sleep 15
        done
    '
    procd_set_param respawn
    procd_close_instance
}